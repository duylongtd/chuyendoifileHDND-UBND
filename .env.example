# Mã truy cập chung của trang (bắt buộc). Đặt trong Vercel → Settings → Environment Variables.
ACCESS_CODE=

# Tùy chọn: chuỗi ngẫu nhiên để ký phiên đăng nhập (đổi giá trị này sẽ đăng xuất mọi người).
SESSION_SECRET=

# Vercel tự thêm khi bật Cron; cần có để /api/cron/cleanup chỉ nhận lệnh từ Vercel Cron.
CRON_SECRET=

# Tự động: Vercel thêm khi Connect Blob store (private) vào project.
# BLOB_READ_WRITE_TOKEN=

# Tùy chọn (mặc định tự chọn):
# STORAGE_DRIVER=blob|local     (local = lưu trong thư mục .data/ khi chạy trên máy)
# QUEUE_DRIVER=vercel|inline    (inline = chạy nền trong function, dùng khi chưa bật Vercel Queues)
# BLOB_ACCESS=private|public    (mặc định private)
